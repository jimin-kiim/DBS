SELECT i.car_id, i.car_type, i.daily_fee * 30 * (1 - d.discount_rate / 100)  as fee
from car_rental_company_car i join car_rental_company_discount_plan d using(car_type) 
where i.car_type in ('세단', 'SUV')
and i.car_id not in (select car_id
                    from car_rental_company_rental_history
                    where start_date <='2022-11-30' and end_date >= '2022-11-01'
                    )
and d.duration_type like '30%'
having fee >= 500000 and fee < 2000000
order by fee desc, car_type asc, car_id desc
-- select 절에서 계산된 fee having, order by 절에서 사용 가능. where 절에서는 사용 불가.